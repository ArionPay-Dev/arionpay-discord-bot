# Discord Developer Portal > your application > General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Discord Developer Portal > your application > Bot > Reset Token
DISCORD_BOT_TOKEN=
# Your server's id (right-click the server > Copy Server ID). Needed for items that give a role.
DISCORD_GUILD_ID=
# Optional: a channel id where the bot posts each sale (for you and your moderators)
SALES_CHANNEL_ID=
# The public https address of this bot. Put PUBLIC_URL/discord/interactions into the Developer Portal
# (General Information > Interactions Endpoint URL).
PUBLIC_URL=https://bot.example.com
PORT=8080
# ArionPay dashboard > your store
ARIONPAY_API_KEY=pk_...
ARIONPAY_API_SECRET=sk_...
# ArionPay dashboard > Webhooks > signing secret
ARIONPAY_WEBHOOK_SECRET=whsec_...
# Keep true until everything works; test invoices take no real money
ARIONPAY_TEST_MODE=true
# Open orders are also re-checked this often (seconds), in case a payment update was missed. 0 = off.
POLL_SECONDS=300
SHOP_WELCOME=Choose what you want to buy. You pay with Bitcoin, USDT and more.
